# Copy this file to .env and fill in your values:   cp .env.example .env
# Never share your .env file or upload it to GitHub (it's already excluded by .gitignore).
# Tip: avoid the "$" character in values, or wrap the whole value in single quotes.

# Your public address. Used to build short URLs and QR codes. No trailing slash.
BASE_URL=https://MYDOMAIN.com

# Password for the admin dashboard at /admin. At least 8 characters; longer is better.
ADMIN_PASSWORD=change-me-please

# Secret used to sign login cookies. Generate a strong random one with:
#   openssl rand -hex 32
# Changing it logs you out everywhere.
SESSION_SECRET=

# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel).
# It's the long string after "--token" in the install command Cloudflare shows you.
TUNNEL_TOKEN=

# Optional: where to send people who visit the bare domain (https://MYDOMAIN.com/).
# Leave empty to show a simple landing page instead.
DEFAULT_REDIRECT_URL=

# Port the app listens on inside Docker. Leave at 3000 unless you have a reason.
# If you change it, use the same port in the tunnel's Public Hostname (http://app:PORT).
PORT=3000

# Time zone used for dates and the scans-per-day chart.
TZ=America/New_York
